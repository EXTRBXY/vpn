<UserControl x:Class="NothingVpn.Desktop.Wpf.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Диагностика" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Проверка подключения и журнал" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Content="Проверить подключение" Command="{Binding RunCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Border Grid.Row="2" Style="{StaticResource CardStyle}"><TextBlock Text="{Binding Result, TargetNullValue=Результат проверки появится здесь}" TextWrapping="Wrap"/></Border><Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="16"><TextBlock Text="Журнал" FontWeight="SemiBold"/><Button Content="Очистить" Command="{Binding ClearCommand}" HorizontalAlignment="Right" Background="#EEF0F4" Foreground="{StaticResource TextBrush}" MinHeight="32"/></Grid><TextBox Grid.Row="1" Text="{Binding LogText}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="16"/></Grid></Border></Grid></UserControl>
