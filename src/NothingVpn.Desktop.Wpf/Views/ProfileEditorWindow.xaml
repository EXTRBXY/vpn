<Window x:Class="NothingVpn.Desktop.Wpf.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:NothingVpn.Domain.Models;assembly=NothingVpn.Domain"
        Title="Профиль" Width="620" Height="560" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="../Assets/app.ico" Style="{StaticResource AppWindowStyle}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" />
            <RowDefinition Height="24" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource DialogTitleTextStyle}" />
        <ScrollViewer Grid.Row="2" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Название" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="NameBox" Margin="{StaticResource FieldMargin}" />
                <TextBlock Text="VLESS-ссылка" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="LinkBox" Margin="{StaticResource FieldMargin}" TextWrapping="NoWrap" />
                <TextBlock Text="Движок подключения" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="EngineBox" SelectedValuePath="Tag" Margin="{StaticResource LastFieldMargin}">
                    <ComboBoxItem Content="Авто" Tag="{x:Static m:OutboundEngine.Auto}" />
                    <ComboBoxItem Content="sing-box" Tag="{x:Static m:OutboundEngine.SingBox}" />
                    <ComboBoxItem Content="Xray" Tag="{x:Static m:OutboundEngine.Xray}" />
                </ComboBox>
                <TextBlock Text="Авто: XHTTP и REALITY — через Xray, остальное — через sing-box. TUN, DNS и правила одинаковы для обоих."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="OnCancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" />
            <Button Content="Сохранить" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
