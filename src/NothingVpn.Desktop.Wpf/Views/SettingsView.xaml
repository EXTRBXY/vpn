<UserControl x:Class="NothingVpn.Desktop.Wpf.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Параметры подключения" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
  <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="DNS" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
   <TextBlock Text="Режим" Foreground="{StaticResource MutedBrush}"/><ComboBox SelectedValue="{Binding DnsMode}" SelectedValuePath="Tag" Margin="0,6,0,12"><ComboBoxItem Content="Системный DNS" Tag="system"/><ComboBoxItem Content="Защищённый DNS (DoH)" Tag="doh"/></ComboBox>
   <TextBlock Text="Сервер" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding DohServer}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="SNI" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding DohSni}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="Путь" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding DohPath}" Padding="10" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="TUN" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Имя интерфейса" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding InterfaceName}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="Адрес CIDR или auto" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding AddressCidr}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="MTU" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Mtu}" Padding="10" Margin="0,6,0,10"/><CheckBox Content="Автоматически настраивать маршруты" IsChecked="{Binding AutoRoute}"/><CheckBox Content="Строгая маршрутизация" IsChecked="{Binding StrictRoute}" Margin="0,8,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Приложения через TUN" FontSize="17" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding TunApps}" SelectedItem="{Binding SelectedTunApp}" MinHeight="80" Margin="0,10,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Добавить приложение" Click="OnAddTunApp"/><Button Content="Удалить" Click="OnRemoveTunApp" Background="#EEF0F4" Foreground="{StaticResource TextBrush}" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Исключения прокси" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding ProxyOverride}" Padding="10" Margin="0,10,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"/></StackPanel></Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="Сохранить" Command="{Binding SaveCommand}"/></StackPanel>
 </StackPanel></ScrollViewer>
</UserControl>
