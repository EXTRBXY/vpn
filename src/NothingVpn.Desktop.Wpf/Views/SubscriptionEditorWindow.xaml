<Window x:Class="NothingVpn.Desktop.Wpf.SubscriptionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подписка" Width="620" Height="460" MinWidth="520" MinHeight="380" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="../Assets/app.ico" Style="{StaticResource AppWindowStyle}">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" />
            <RowDefinition Height="24" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource DialogTitleTextStyle}" />
        <ScrollViewer Grid.Row="2" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Название" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="NameBox" Margin="{StaticResource FieldMargin}" />
                <TextBlock Text="Адрес подписки" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="UrlBox" Margin="{StaticResource FieldMargin}" />
                <CheckBox x:Name="EnabledBox" Content="Обновлять автоматически" IsChecked="True" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="OnCancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" />
            <Button Content="Сохранить" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
