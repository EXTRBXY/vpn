<Window x:Class="NothingVpn.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nothing VPN" Width="920" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,2,0,34">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="N" Foreground="White" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nothing VPN" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Content="Главная" Command="{Binding ShowHomeCommand}" HorizontalContentAlignment="Left"
                            Background="#EDF2FF" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                    <Button Content="Профили" Command="{Binding ShowProfilesCommand}" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="{StaticResource TextBrush}" />
                    <Button Content="Настройки" Command="{Binding ShowSettingsCommand}" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="Работает в системном трее" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="4,0,4,10" />
                    <Button Content="Выйти" Command="{Binding ExitCommand}" Background="#EEF0F4"
                            Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HomeVisibility}">
            <StackPanel>
                <TextBlock Text="Подключение" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Выберите профиль и режим работы" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,24" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,1,9,0" />
                                <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource MutedBrush}" Margin="19,7,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ConnectionActionText}" Command="{Binding ToggleConnectionCommand}"
                                MinWidth="142" Background="{Binding ActionBrush}" />
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Профиль" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <ComboBox Margin="0,9,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name" IsEnabled="{Binding CanEdit}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Режим" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <ComboBox Margin="0,9,0,0" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                      DisplayMemberPath="Name" IsEnabled="{Binding CanEdit}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Сведения" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Профиль" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProfileDetail}" />
                            <TextBlock Grid.Row="1" Text="Режим" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModeDetail}" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2" Text="DNS" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DnsDetail}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="3" Text="Правила" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RuleSetsDetail}" Margin="0,12,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#FFF5D9" CornerRadius="10" Padding="14" Margin="0,18,0,0"
                        Visibility="{Binding ErrorVisibility}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#7A4D00" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <local:ProfilesView xmlns:local="clr-namespace:NothingVpn.Desktop.Wpf" Grid.Column="2"
                            DataContext="{Binding ProfileManager}"
                            Visibility="{Binding DataContext.ProfilesVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
        <local:SettingsView xmlns:local="clr-namespace:NothingVpn.Desktop.Wpf" Grid.Column="2"
                            DataContext="{Binding Settings}"
                            Visibility="{Binding DataContext.SettingsVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Grid>
</Window>
