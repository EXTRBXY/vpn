<UserControl x:Class="NothingVpn.Desktop.Wpf.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnSettingsMouseWheel"><StackPanel>
  <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Параметры подключения" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,22"/>
  <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="DNS" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
   <TextBlock Text="Режим" Foreground="{DynamicResource MutedBrush}"/><ComboBox SelectedValue="{Binding DnsMode}" SelectedValuePath="Tag" Margin="0,6,0,12"><ComboBoxItem Content="Системный DNS" Tag="system"/><ComboBoxItem Content="Защищённый DNS (DoH)" Tag="doh"/></ComboBox>
   <TextBlock Text="Готовая настройка" Foreground="{DynamicResource MutedBrush}"/><ComboBox SelectionChanged="OnDnsPreset" Margin="0,6,0,12"><ComboBoxItem Content="Cloudflare" Tag="cloudflare"/><ComboBoxItem Content="Google" Tag="google"/><ComboBoxItem Content="Quad9" Tag="quad9"/><ComboBoxItem Content="AdGuard" Tag="adguard"/></ComboBox>
   <TextBlock Text="Маршрут DNS" Foreground="{DynamicResource MutedBrush}"/><ComboBox SelectedValue="{Binding DnsDetour}" SelectedValuePath="Tag" Margin="0,6,0,12"><ComboBoxItem Content="Напрямую" Tag="direct"/><ComboBoxItem Content="Через VPN" Tag="proxy"/></ComboBox>
   <TextBlock Text="Сервер" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding DohServer}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="SNI" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding DohSni}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="Путь" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding DohPath}" Padding="10" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="TUN" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Имя интерфейса" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding InterfaceName}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="Адрес CIDR или auto" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding AddressCidr}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="MTU" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding Mtu}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="Сетевой стек" Foreground="{DynamicResource MutedBrush}"/><ComboBox SelectedValue="{Binding Stack}" SelectedValuePath="Tag" Margin="0,6,0,10"><ComboBoxItem Content="Системный" Tag=""/><ComboBoxItem Content="Смешанный" Tag="mixed"/><ComboBoxItem Content="gVisor" Tag="gvisor"/></ComboBox><CheckBox Content="Автоматически настраивать маршруты" IsChecked="{Binding AutoRoute}"/><CheckBox Content="Строгая маршрутизация" IsChecked="{Binding StrictRoute}" Margin="0,8,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Приложения через TUN" FontSize="17" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding TunApps}" SelectedItem="{Binding SelectedTunApp}" MinHeight="92" Margin="0,10,0,10"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource SubtleBrush}"><Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal"><Button Content="Найти приложение" Click="OnFindTunApp"/><Button Content="Выбрать .exe" Click="OnAddTunApp" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/><Button Content="Удалить" Click="OnRemoveTunApp" Style="{StaticResource DangerButtonStyle}" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Исключения прокси" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding ProxyOverride}" Padding="10" Margin="0,10,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"/></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" DataContext="{Binding Updates}"><StackPanel><TextBlock Text="Обновления" FontSize="17" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,10"><Run Text="Текущая версия: "/><Run Text="{Binding CurrentVersion, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Проверить" Command="{Binding CheckCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="Установить" Command="{Binding InstallCommand}" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Приложение" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="При закрытии окна" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,6"/><ComboBox SelectedValue="{Binding CloseBehavior}" SelectedValuePath="Tag"><ComboBoxItem Content="Скрывать в системный трей" Tag="tray"/><ComboBoxItem Content="Полностью завершать приложение" Tag="exit"/></ComboBox></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Журнал" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Уровень сообщений" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,6"/><ComboBox SelectedValue="{Binding LogLevel}" SelectedValuePath="Tag"><ComboBoxItem Content="Ошибки" Tag="error"/><ComboBoxItem Content="Предупреждения" Tag="warn"/><ComboBoxItem Content="Информация" Tag="info"/><ComboBoxItem Content="Отладка" Tag="debug"/></ComboBox></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Правила маршрутизации" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="Встроенные списки" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,5"/><DataGrid ItemsSource="{Binding BuiltinRuleSets}" SelectedItem="{Binding SelectedBuiltinRuleSet}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="110"><DataGrid.Columns><DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled}"/><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridComboBoxColumn Header="Действие" SelectedValueBinding="{Binding Action}" SelectedValuePath="Tag"><DataGridComboBoxColumn.ItemsSource><x:Array Type="{x:Type ComboBoxItem}"><ComboBoxItem Content="Напрямую" Tag="direct"/><ComboBoxItem Content="Блокировать" Tag="block"/></x:Array></DataGridComboBoxColumn.ItemsSource></DataGridComboBoxColumn></DataGrid.Columns></DataGrid>
   <StackPanel Orientation="Horizontal" Margin="0,8,0,12"><Button Content="Скачать или обновить" Click="OnDownloadBuiltin"/><Button Content="Удалить файл" Click="OnRemoveBuiltin" Style="{StaticResource DangerButtonStyle}" Margin="10,0,0,0"/><Button Content="Другие списки" Click="OnOpenRuleCatalog" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/></StackPanel>
   <TextBlock Text="Пользовательские списки" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/><DataGrid ItemsSource="{Binding UserRuleSets}" SelectedItem="{Binding SelectedUserRuleSet}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="110"><DataGrid.Columns><DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled}"/><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridComboBoxColumn Header="Действие" SelectedValueBinding="{Binding Action}" SelectedValuePath="Tag"><DataGridComboBoxColumn.ItemsSource><x:Array Type="{x:Type ComboBoxItem}"><ComboBoxItem Content="Напрямую" Tag="direct"/><ComboBoxItem Content="Блокировать" Tag="block"/></x:Array></DataGridComboBoxColumn.ItemsSource></DataGridComboBoxColumn></DataGrid.Columns></DataGrid>
   <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Добавить .srs" Click="OnImportRuleSet"/><Button Content="Удалить" Click="OnRemoveRuleSet" Style="{StaticResource DangerButtonStyle}" Margin="10,0,0,0"/><Button Content="Сохранить правила" Click="OnSaveRuleSets" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/></StackPanel>
  </StackPanel></Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="Сохранить" Command="{Binding SaveCommand}"/></StackPanel>
 </StackPanel></ScrollViewer>
</UserControl>
