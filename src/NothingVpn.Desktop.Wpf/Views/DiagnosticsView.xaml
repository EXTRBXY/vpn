<UserControl x:Class="NothingVpn.Desktop.Wpf.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Диагностика" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Проверка подключения и журнал" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Content="Проверить подключение" Command="{Binding RunCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Border Grid.Row="2" Style="{StaticResource CardStyle}"><TextBlock Text="{Binding Result, TargetNullValue=Результат проверки появится здесь}" TextWrapping="Wrap"/></Border><Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="16"><StackPanel Orientation="Horizontal"><TextBlock Text="Журнал" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox SelectedValue="{Binding MinimumLevel}" SelectedValuePath="Tag" Width="120" Margin="14,0,0,0"><ComboBoxItem Content="Все" Tag="0"/><ComboBoxItem Content="Отладка" Tag="1"/><ComboBoxItem Content="Информация" Tag="2"/><ComboBoxItem Content="Предупреждения" Tag="3"/><ComboBoxItem Content="Ошибки" Tag="4"/></ComboBox></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Копировать" Click="OnCopy" Background="#EEF0F4" Foreground="{StaticResource TextBrush}" MinHeight="32"/><Button Content="Сохранить" Click="OnExport" Background="#EEF0F4" Foreground="{StaticResource TextBrush}" MinHeight="32" Margin="8,0,0,0"/><Button Content="Очистить" Command="{Binding ClearCommand}" Background="#EEF0F4" Foreground="{StaticResource TextBrush}" MinHeight="32" Margin="8,0,0,0"/></StackPanel></Grid><TextBox Grid.Row="1" Text="{Binding LogText}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="16"/></Grid></Border></Grid></UserControl>
