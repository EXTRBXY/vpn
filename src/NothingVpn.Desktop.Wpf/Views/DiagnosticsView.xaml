<UserControl x:Class="NothingVpn.Desktop.Wpf.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:NothingVpn.Domain.Models;assembly=NothingVpn.Domain">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Диагностика" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Проверка подключения и журнал" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Button Content="Проверить подключение" Command="{Binding RunCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <TextBlock Text="{Binding Result, TargetNullValue=Результат проверки появится здесь}" TextWrapping="Wrap" />
        </Border>
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16">
                    <TextBlock Text="Журнал" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Показывать" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox SelectedValue="{Binding MinLevel}" SelectedValuePath="Tag" MinWidth="150" Margin="0,0,16,0"
                                  VerticalAlignment="Center" ToolTip="Минимальный уровень записей в окне. «Сохранить» записывает весь журнал.">
                            <ComboBoxItem Content="Ошибки" Tag="{x:Static m:LogLevel.Error}" />
                            <ComboBoxItem Content="Предупреждения" Tag="{x:Static m:LogLevel.Warn}" />
                            <ComboBoxItem Content="Информация" Tag="{x:Static m:LogLevel.Info}" />
                            <ComboBoxItem Content="Отладка (всё)" Tag="{x:Static m:LogLevel.Trace}" />
                        </ComboBox>
                        <Button Content="Копировать" Click="OnCopy" Style="{StaticResource SecondaryButtonStyle}" MinHeight="32" />
                        <Button Content="Сохранить" Click="OnExport" Style="{StaticResource SecondaryButtonStyle}" MinHeight="32"
                                Margin="8,0,0,0" />
                        <Button Content="Очистить" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                         Padding="16" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
