<UserControl x:Class="NothingVpn.Desktop.Wpf.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:NothingVpn.Domain.Models;assembly=NothingVpn.Domain">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Диагностика" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Проверка подключения и журнал" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,16" />
            <Button Content="Проверить подключение" Command="{Binding RunCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <TextBlock Text="{Binding Result, TargetNullValue=Результат проверки появится здесь}" TextWrapping="Wrap" />
        </Border>
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16">
                    <TextBlock Text="Журнал" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                            <TextBlock Text="Показывать" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox SelectedValue="{Binding MinLevel}" SelectedValuePath="Tag" MinWidth="160"
                                      Style="{StaticResource CompactComboBoxStyle}"
                                      ToolTip="Минимальный уровень записей в окне. «Сохранить» записывает весь журнал.">
                                <ComboBoxItem Content="Ошибки" Tag="{x:Static m:LogLevel.Error}" />
                                <ComboBoxItem Content="Предупреждения" Tag="{x:Static m:LogLevel.Warn}" />
                                <ComboBoxItem Content="Информация" Tag="{x:Static m:LogLevel.Info}" />
                                <ComboBoxItem Content="Отладка (всё)" Tag="{x:Static m:LogLevel.Trace}" />
                            </ComboBox>
                        </StackPanel>
                        <Button Content="Копировать" Click="OnCopy" Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,8,8" />
                        <Button Content="Сохранить" Click="OnExport" Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,8,8" />
                        <Button Content="Очистить" Command="{Binding ClearCommand}" Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Stretch" FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                         Padding="16" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
