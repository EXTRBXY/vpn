<UserControl x:Class="NothingVpn.Desktop.Wpf.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnSettingsMouseWheel"><StackPanel>
  <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Параметры подключения" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,22"/>
  <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="DNS" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
   <TextBlock Text="Режим" Foreground="{DynamicResource MutedBrush}"/><ComboBox SelectedValue="{Binding DnsMode}" SelectedValuePath="Tag" Margin="0,6,0,12"><ComboBoxItem Content="Системный DNS" Tag="system"/><ComboBoxItem Content="Защищённый DNS (DoH)" Tag="doh"/></ComboBox>
   <TextBlock Text="Готовая настройка" Foreground="{DynamicResource MutedBrush}"/><ComboBox IsEnabled="{Binding IsDohMode}" SelectedValue="{Binding DnsPreset}" SelectedValuePath="Tag" Margin="0,6,0,12"><ComboBoxItem Content="Свои параметры" Tag="custom"/><ComboBoxItem Content="Cloudflare" Tag="cloudflare"/><ComboBoxItem Content="Google" Tag="google"/><ComboBoxItem Content="Quad9" Tag="quad9"/><ComboBoxItem Content="AdGuard" Tag="adguard"/></ComboBox>
   <TextBlock Text="Маршрут DNS" Foreground="{DynamicResource MutedBrush}"/><ComboBox SelectedValue="{Binding DnsDetour}" SelectedValuePath="Tag" IsEnabled="{Binding IsDnsDetourEditable}" Margin="0,6,0,4"><ComboBoxItem Content="Напрямую" Tag="direct"/><ComboBoxItem Content="Через VPN" Tag="proxy"/></ComboBox><TextBlock Text="{Binding DnsDetourHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DnsDetourHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <TextBlock Text="Сервер" Foreground="{DynamicResource MutedBrush}"/><TextBox IsEnabled="{Binding IsDohMode}" Text="{Binding DohServer, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="SNI" Foreground="{DynamicResource MutedBrush}"/><TextBox IsEnabled="{Binding IsDohMode}" Text="{Binding DohSni, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="Путь" Foreground="{DynamicResource MutedBrush}"/><TextBox IsEnabled="{Binding IsDohMode}" Text="{Binding DohPath, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="TUN" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Имя интерфейса" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding InterfaceName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="Адрес CIDR или auto" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding AddressCidr, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="MTU" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding MtuText, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,6,0,10"/><TextBlock Text="Сетевой стек" Foreground="{DynamicResource MutedBrush}"/><ComboBox SelectedValue="{Binding Stack}" SelectedValuePath="Tag" Margin="0,6,0,10"><ComboBoxItem Content="Системный" Tag=""/><ComboBoxItem Content="Смешанный" Tag="mixed"/><ComboBoxItem Content="gVisor" Tag="gvisor"/></ComboBox><CheckBox Content="Автоматически настраивать маршруты" IsChecked="{Binding AutoRoute}"/><CheckBox Content="Строгая маршрутизация" IsChecked="{Binding StrictRoute}" Margin="0,8,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Приложения через TUN" FontSize="17" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding TunApps}" SelectedItem="{Binding SelectedTunApp}" MinHeight="92" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,10"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource SubtleBrush}"><Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal"><Button Content="Найти приложение" Click="OnFindTunApp"/><Button Content="Выбрать .exe" Click="OnAddTunApp" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/><Button Content="Удалить" Click="OnRemoveTunApp" IsEnabled="{Binding CanRemoveTunApp}" Style="{StaticResource DangerButtonStyle}" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Исключения прокси" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding ProxyOverride, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,10,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"/></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" DataContext="{Binding Updates}"><StackPanel><TextBlock Text="Обновления" FontSize="17" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,10"><Run Text="Текущая версия: "/><Run Text="{Binding CurrentVersion, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Проверить" Command="{Binding CheckCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="Установить" Command="{Binding InstallCommand}" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Приложение" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="При закрытии окна" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,6"/><ComboBox SelectedValue="{Binding CloseBehavior}" SelectedValuePath="Tag"><ComboBoxItem Content="Скрывать в системный трей" Tag="tray"/><ComboBoxItem Content="Полностью завершать приложение" Tag="exit"/></ComboBox></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Журнал" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Уровень сообщений" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,6"/><ComboBox SelectedValue="{Binding LogLevel}" SelectedValuePath="Tag"><ComboBoxItem Content="Ошибки" Tag="error"/><ComboBoxItem Content="Предупреждения" Tag="warn"/><ComboBoxItem Content="Информация" Tag="info"/><ComboBoxItem Content="Отладка" Tag="debug"/></ComboBox></StackPanel></Border>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Правила маршрутизации" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="Встроенные списки" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,5"/><DataGrid ItemsSource="{Binding BuiltinRuleSets}" SelectedItem="{Binding SelectedBuiltinRuleSet}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding CanEditRuleSets}" MinHeight="110"><DataGrid.Columns><DataGridTemplateColumn Header="Вкл."><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnBuiltinEnabledClick" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Название" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTemplateColumn Header="Действие"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"><ComboBoxItem Content="Напрямую" Tag="direct"/><ComboBoxItem Content="Блокировать" Tag="block"/></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   <StackPanel Orientation="Horizontal" Margin="0,8,0,12"><Button Content="Скачать или обновить" Click="OnDownloadBuiltin" IsEnabled="{Binding CanUseBuiltinRuleSet}"/><Button Content="Удалить файл" Click="OnRemoveBuiltin" IsEnabled="{Binding CanUseBuiltinRuleSet}" Style="{StaticResource DangerButtonStyle}" Margin="10,0,0,0"/><Button Content="Другие списки" Click="OnOpenRuleCatalog" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/></StackPanel>
   <TextBlock Text="Пользовательские списки" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/><DataGrid ItemsSource="{Binding UserRuleSets}" SelectedItem="{Binding SelectedUserRuleSet}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding CanEditRuleSets}" MinHeight="110"><DataGrid.Columns><DataGridTemplateColumn Header="Вкл."><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Название" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTemplateColumn Header="Действие"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"><ComboBoxItem Content="Напрямую" Tag="direct"/><ComboBoxItem Content="Блокировать" Tag="block"/></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
   <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Добавить .srs" Click="OnImportRuleSet" IsEnabled="{Binding CanEditRuleSets}"/><Button Content="Удалить" Click="OnRemoveRuleSet" IsEnabled="{Binding CanRemoveUserRuleSet}" Style="{StaticResource DangerButtonStyle}" Margin="10,0,0,0"/></StackPanel>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
 <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" Padding="0,12,0,0"><StackPanel>
  <TextBlock Text="{Binding ConnectionNotice}" Foreground="{DynamicResource WarningBrush}" Margin="0,16,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ConnectionNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,8"/><Button Content="Сохранить все настройки" Command="{Binding SaveCommand}" HorizontalAlignment="Right"/>
 </StackPanel></Border></Grid>
</UserControl>
